# টালিখাতা — Database Configuration
#
# PostgreSQL (default):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
#
# MySQL 8.0 (change prisma/schema.prisma provider to "mysql" first):
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
#
# Local PostgreSQL example:
DATABASE_URL="postgresql://postgres:password@localhost:5432/tolikhata?schema=public"

# Local MySQL example (uncomment and update schema.prisma provider):
# DATABASE_URL="mysql://root:password@localhost:3306/tolikhata"

# Session secret — must be at least 32 characters, keep it secret!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-random-32-char-secret-string!!"
